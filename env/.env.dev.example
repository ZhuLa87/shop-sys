# ── 開發環境 ─────────────────────────────────────────────────────────────────
# 使用方式:
#   cp env/.env.dev.example env/.env.dev
#   chmod 600 env/.env.dev
#   把所有 CHANGE_ME 換掉 (產生方式見下) ,然後 ./stack.sh up
#
# 產生隨機值:
#   密碼      openssl rand -base64 18 | tr -dc 'A-Za-z0-9'
#   JWT 金鑰  openssl rand -base64 48
#
# 這份範本會進版控,因此不放任何可用的憑證 —— 即使是開發環境也一樣.
# 原因:除錯用埠 (13306 / 16379) 綁在 0.0.0.0,同網段/tailnet 上的其他裝置
# 連得到你的 dev 資料庫,擋在前面的就只有這組密碼.
# 實際使用的 env/.env.dev 已被 .gitignore 排除.

COMPOSE_PROJECT_NAME=shop-sys-dev
TZ=Asia/Taipei

# ── 對外位址與埠號 ───────────────────────────────────────────────────────────
# PUBLIC_HOST 必須與 TLS 憑證上的網域一致,否則瀏覽器會跳憑證錯誤
PUBLIC_HOST=tu-zhu.soay-fish.ts.net
# 這台機器上 443 / 80 / 9000 已被其他容器佔用,故一律避開
NGINX_HTTPS_PORT=8443
NGINX_HTTP_PORT=8080
NGINX_S3_PORT=8444
# MinIO Console 管理介面 (僅 dev 掛載對應的 nginx 設定)
NGINX_MINIO_CONSOLE_PORT=8445
MAX_UPLOAD_SIZE=20m

# ── TLS 憑證 (由 nginx 終結) ─────────────────────────────────────────────────
# 掛載主機上既有的 tailscale 憑證目錄,以唯讀方式進 nginx
TLS_CERT_DIR=/home/zhu/tailscale-cert
TLS_CERT_FILE=tu-zhu.soay-fish.ts.net.crt
TLS_KEY_FILE=tu-zhu.soay-fish.ts.net.key

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL_APP=DEBUG
JPA_SHOW_SQL=true
ACCOUNT_LOCKING_ENABLED=true

# ── 資料庫 ───────────────────────────────────────────────────────────────────
DB_NAME=shop_sys
DB_USERNAME=shop_sys
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────────────────────
# HS512 需要足夠長度的金鑰,至少 64 bytes
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=shop-sys-public
# 後端專用金鑰 (由 minio-init 建立,權限 readwrite)
MINIO_ACCESS_KEY=shop-sys-backend
MINIO_SECRET_KEY=CHANGE_ME
# 瀏覽器實際連線的 S3 位址.後端用它產生 presigned URL,
# SigV4 簽章涵蓋 Host,所以這裡不能填 http://minio:9000 之類的內部位址
PUBLIC_S3_URL=https://tu-zhu.soay-fish.ts.net:8444

# ── 綠界金流 (ECPay AIO) ─────────────────────────────────────────────────────
# 綠界官方公開的 stage 測試帳號 (所有開發者共用),正式環境務必換成自己的特店帳號
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_CHECKOUT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# 綠界 server 只能連 80/443 埠,連不到 tailnet 的 8443,
# 由 Tailscale Funnel 只把付款回呼路徑公開在 443 (做法見 docker/README.md"綠界金流本機測試")
ECPAY_CALLBACK_BASE_URL=https://tu-zhu.soay-fish.ts.net/api
# 付款完成後導回的前端,瀏覽器在 tailnet 內所以可以直接用 8443
APP_FRONTEND_BASE_URL=https://tu-zhu.soay-fish.ts.net:8443

# ── 容器執行身分 (僅 dev) ────────────────────────────────────────────────────
# backend 容器會寫入掛載進去的 target/,必須用與主機使用者相同的 uid 執行,
# 否則產生的檔案會變成 root 所有,主機上的 ./mvnw 會因權限不足而失敗.
# 用 `id -u` / `id -g` 查自己的值
DEV_UID=1000
DEV_GID=1000

# ── 除錯用埠號 (僅 dev) ──────────────────────────────────────────────────────
# 讓 DBeaver / RedisInsight 可以從主機或 tailnet 上的其他電腦連進來.
# 綁在 0.0.0.0,所以上面那組密碼是真的在擋人,不要填弱密碼.
# 這些埠都要避開主機上既有服務 (3306 / 5540 / 6379 / 9000 / 9001 已被佔用) .
# MinIO Console 不在這裡:它走 nginx 的 NGINX_MINIO_CONSOLE_PORT,以 HTTPS 對外.
DEBUG_DB_PORT=13306
DEBUG_REDIS_PORT=16379
# Redis 網頁管理介面 (RedisInsight) ,走 HTTPS,憑證沿用上面的 TLS_CERT_DIR
DEBUG_REDISINSIGHT_PORT=15540
