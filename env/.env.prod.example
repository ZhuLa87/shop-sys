# ── 正式環境 ─────────────────────────────────────────────────────────────────
# 使用方式:cp env/.env.prod.example env/.env.prod,把所有 CHANGE_ME 換掉,
# 再執行 make prod-up
#
# 注意事項:
#   - SPRING_PROFILES_ACTIVE=prod 會關閉 Swagger (/swagger-ui/** 是 permitAll,
#     不應對外公開完整 API 結構)
#   - 這份檔案含全部機密,權限請設為 600,且絕對不要 commit
#   - 下列埠號預設為標準的 443 / 80.若部署機器上已有其他服務佔用,請改掉

COMPOSE_PROJECT_NAME=shop-sys-prod
TZ=Asia/Taipei
IMAGE_TAG=latest

# ── 對外位址與埠號 ───────────────────────────────────────────────────────────
PUBLIC_HOST=CHANGE_ME.example.com
NGINX_HTTPS_PORT=443
NGINX_HTTP_PORT=80
NGINX_S3_PORT=8444
MAX_UPLOAD_SIZE=20m

# ── TLS 憑證 ─────────────────────────────────────────────────────────────────
# 目錄下需有下列兩個檔名的憑證與私鑰 (例如 certbot 的 fullchain.pem / privkey.pem)
TLS_CERT_DIR=/etc/letsencrypt/live/CHANGE_ME.example.com
TLS_CERT_FILE=fullchain.pem
TLS_KEY_FILE=privkey.pem

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL_APP=INFO
JPA_SHOW_SQL=false
ACCOUNT_LOCKING_ENABLED=true

# ── 資源上限 ─────────────────────────────────────────────────────────────────
# JVM 以 MaxRAMPercentage=75 依此上限自動調整 heap
BACKEND_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=512m

# ── 資料庫 ───────────────────────────────────────────────────────────────────
DB_NAME=shop_sys
DB_USERNAME=shop_sys
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────────────────────
# 產生方式:openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=shop-sys-public
MINIO_ACCESS_KEY=shop-sys-backend
MINIO_SECRET_KEY=CHANGE_ME
PUBLIC_S3_URL=https://CHANGE_ME.example.com:8444

# ── 綠界金流 (ECPay AIO) ─────────────────────────────────────────────────────
# 正式特店帳號,MerchantID 與 HashKey/HashIV 必須成對
ECPAY_MERCHANT_ID=CHANGE_ME
ECPAY_HASH_KEY=CHANGE_ME
ECPAY_HASH_IV=CHANGE_ME
ECPAY_CHECKOUT_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
# 綠界 server 打得到的 API base (含 /api),只能是 80/443 埠且不可放在 CDN 後方
ECPAY_CALLBACK_BASE_URL=https://CHANGE_ME.example.com/api
APP_FRONTEND_BASE_URL=https://CHANGE_ME.example.com
