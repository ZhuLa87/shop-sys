# ── 測試 (staging) 環境 ──────────────────────────────────────────────────────
# 使用方式:cp env/.env.staging.example env/.env.staging,把所有 CHANGE_ME 換掉,
# 再執行 make staging-up
#
# 與 dev 的差異:
#   - 使用 build 產出的 image (fat jar + nuxt .output) ,不掛載原始碼,無 hot reload
#   - SPRING_PROFILES_ACTIVE=staging,不會執行 DataInitializer 建立測試資料
#   - 埠號與 dev 錯開,可以在同一台機器上與 dev 並存

COMPOSE_PROJECT_NAME=shop-sys-staging
TZ=Asia/Taipei
IMAGE_TAG=staging

# ── 對外位址與埠號 ───────────────────────────────────────────────────────────
PUBLIC_HOST=tu-zhu.soay-fish.ts.net
NGINX_HTTPS_PORT=8543
NGINX_HTTP_PORT=8180
NGINX_S3_PORT=8544
MAX_UPLOAD_SIZE=20m

# ── TLS 憑證 ─────────────────────────────────────────────────────────────────
TLS_CERT_DIR=/home/zhu/tailscale-cert
TLS_CERT_FILE=tu-zhu.soay-fish.ts.net.crt
TLS_KEY_FILE=tu-zhu.soay-fish.ts.net.key

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=staging
LOG_LEVEL_APP=INFO
JPA_SHOW_SQL=false
ACCOUNT_LOCKING_ENABLED=true

# ── 資料庫 ───────────────────────────────────────────────────────────────────
DB_NAME=shop_sys
DB_USERNAME=shop_sys
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────────────────────
# 產生方式:openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=shop-sys-public
MINIO_ACCESS_KEY=shop-sys-backend
MINIO_SECRET_KEY=CHANGE_ME
PUBLIC_S3_URL=https://tu-zhu.soay-fish.ts.net:8544

# ── 綠界金流 (ECPay AIO) ─────────────────────────────────────────────────────
# 綠界官方公開的 stage 測試帳號 (所有開發者共用),正式環境務必換成自己的特店帳號
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_CHECKOUT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# 與 dev 共用同一個 Funnel 路徑 (443 只有一個),同一時間只有一個環境收得到回呼
ECPAY_CALLBACK_BASE_URL=https://tu-zhu.soay-fish.ts.net/api
APP_FRONTEND_BASE_URL=https://tu-zhu.soay-fish.ts.net:8543
